{
  "name": "arriscai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:migrations": "node scripts/test-migration-upgrade.mjs",
    "seed": "node scripts/seed.mjs",
    "test:db": "node scripts/test-db.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "@tailwindcss/postcss": "^4.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
